# PromptForge Pipeline Configuration

# Database
DATABASE_URL=postgresql+asyncpg://promptforge:password@localhost/promptforge

# Storage Backend (filesystem or s3)
STORAGE_BACKEND=filesystem
STORAGE_BASE_PATH=./data/storage

# S3 Configuration (if using S3)
# AWS_S3_BUCKET=my-bucket
# AWS_REGION=us-east-1

# OCR Provider (tesseract, easyocr, custom)
OCR_PROVIDER=tesseract

# Custom OCR Endpoint (if provider=custom)
# OCR_CUSTOM_ENDPOINT=http://localhost:9000/ocr

# LLM Provider (mock, azure, openai, custom)
LLM_PROVIDER=mock

# Azure OpenAI Configuration (if provider=azure)
# AZURE_OPENAI_API_KEY=your-api-key
# AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI Configuration (if provider=openai)
# OPENAI_API_KEY=your-api-key

# Custom LLM Endpoint (if provider=custom)
# LLM_CUSTOM_ENDPOINT=http://localhost:8080/generate

# Worker Settings
WORKER_ID=worker-local-1
WORKER_MAX_CONCURRENT_JOBS=2
WORKER_HEARTBEAT_INTERVAL=30

# Watchdog Settings
WATCHDOG_INTERVAL=60
WATCHDOG_STALE_THRESHOLD=90

# Feature Flags
USE_NEW_PIPELINE=true
ENABLE_IDEMPOTENCY_CACHE=true

# Logging
LOG_LEVEL=INFO
STRUCTURED_LOGGING=false
